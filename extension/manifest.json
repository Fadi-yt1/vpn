{
  "manifest_version": 3,
  "name": "Tervyn VPN",
  "short_name": "Tervyn",
  "version": "1.0.0",
  "description": "Free browser VPN with automatic fast free servers. Protect all sites, or only the sites you choose.",
  "key": "",
  "minimum_chrome_version": "110",
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Tervyn VPN",
    "default_icon": { "16": "icons/off16.png", "32": "icons/off32.png", "48": "icons/off48.png" }
  },
  "icons": { "16": "icons/on16.png", "32": "icons/on32.png", "48": "icons/on48.png", "128": "icons/on128.png" },
  "permissions": [
    "proxy",
    "storage",
    "alarms",
    "tabs",
    "nativeMessaging",
    "webRequest",
    "webRequestAuthProvider"
  ],
  "host_permissions": ["<all_urls>"]
}
